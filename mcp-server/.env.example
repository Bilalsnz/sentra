# BNB Chain mainnet defaults to a public RPC. Override if needed.
BSC_CHAIN_ID=56
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Set after deployment. The tool reports UNRATED when this is empty.
SENTRA_REGISTRY=

# Optional. Enables the explorer source-verification check.
# Keep this key local. Sentra never transmits it anywhere except the explorer API.
BSCSCAN_API_URL=https://api.etherscan.io/v2/api
BSCSCAN_API_KEY=
